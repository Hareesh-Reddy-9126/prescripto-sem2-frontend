{
  "name": "prescripto-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:patient": "npm run dev --workspace=packages/patient",
    "dev:admin": "npm run dev --workspace=packages/admin",
    "dev:pharmacist": "npm run dev --workspace=packages/pharmacist",
    "build:all": "npm run build --workspaces --if-present",
    "build:patient": "npm run build --workspace=packages/patient",
    "build:admin": "npm run build --workspace=packages/admin",
    "build:pharmacist": "npm run build --workspace=packages/pharmacist",
    "lint:all": "npm run lint --workspaces --if-present",
    "install:all": "npm install --workspaces"
  },
  "devDependencies": {
    "eslint": "^8.56.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}